# PID environment overrides — copy to .env.local

# Path to the durable SQLite database file (default: ./pid.sqlite)
PID_DB_PATH=./pid.sqlite

# scrypt hash of the login passphrase. If unset, the app falls back to the
# dev passphrase "pid-dev". Generate a hash with:
#   node -e "import('./src/lib/auth.ts').then(m => console.log(m.hashPassphrase('your-passphrase')))"
# (or use the exported hashPassphrase helper). Format: scrypt$<saltHex>$<hashHex>
# PID_PASSPHRASE_HASH=

# Expected local origin for CSRF/DNS-rebind checks (default: derived from host)
# PID_APP_ORIGIN=http://127.0.0.1:3000
